{
  "name": "mdy-docs",
  "version": "0.0.1",
  "description": "Documents with data, sandboxed templates, a real query engine, and a static site generator built on all three",
  "homepage": "https://github.com/mdy-docs/mdy-docs#readme",
  "bugs": {
    "url": "https://github.com/mdy-docs/mdy-docs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mdy-docs/mdy-docs.git"
  },
  "license": "BSD-2-Clause",
  "author": "",
  "type": "module",
  "main": "index.js",
  "bin": {
    "mdy": "bin/mdy.js"
  },
  "files": [
    "index.js",
    "src/",
    "bin/"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:react": "npm --prefix packages/mdy-react test",
    "mdy-web": "node packages/mdy-web/bin/mdy-web.js examples/blog",
    "live-preview": "npm --prefix packages/mdy-live-preview run dev",
    "test:mdy-site": "npm --prefix packages/mdy-site test",
    "mdy-site": "npm --prefix packages/mdy-site run dev",
    "test:mdy-bus": "npm --prefix packages/mdy-bus test",
    "build:browser": "node scripts/build-browser.mjs",
    "test:browser": "node --test test/browser/*.test.js"
  },
  "dependencies": {
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/png": "^3.1.1",
    "@jsquash/resize": "^2.1.1",
    "@mdy-docs/lamassu-js": "file:third_party/lamassu-js/packages/lamassu-js",
    "@mdy-docs/nisaba-db": "file:third_party/nisaba-db",
    "emoticon": "^4.1.0",
    "gemoji": "^8.1.0",
    "hastscript": "^9.0.1",
    "html-void-elements": "^3.0.0",
    "image-size": "^2.0.2",
    "linkify-it": "^6.1.0",
    "lowlight": "^3.3.0",
    "property-information": "^7.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-github-blockquote-alert": "^2.1.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "playwright": "^1.61.1",
    "@mdy-docs/mdy-bus": "file:packages/mdy-bus",
    "esbuild": "^0.28.2"
  },
  "exports": {
    ".": "./index.js",
    "./parse": "./src/parse/index.js",
    "./parse/*": "./src/parse/*",
    "./tasks": "./src/parse/enhance.js",
    "./package.json": "./package.json"
  }
}
