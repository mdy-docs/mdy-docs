#include <stdio.h>
#include <stdlib.h>
#define MAX(a, b) ((a) > (b) ? (a) : (b))
typedef struct { int x; double y; } point_t;
static int compare(const void *a, const void *b) {
    return ((const point_t *)a)->x - ((const point_t *)b)->x; /* by x */
}
int main(int argc, char **argv) {
    point_t pts[3] = {{3, 1.5}, {1, 2.5}, {2, 0.0}};
    qsort(pts, 3, sizeof pts[0], compare);
    for (int i = 0; i < 3; i++) printf("%d %.1f\n", pts[i].x, pts[i].y);
    return argc > 1 ? EXIT_FAILURE : 0;
}
