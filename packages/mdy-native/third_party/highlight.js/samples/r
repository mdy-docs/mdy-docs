# a script
library(dplyr)
fib <- function(n) if (n < 2) n else fib(n - 1) + fib(n - 2)
x <- c(1, 2.5, 3L, NA)
df <- data.frame(a = x, b = x * 2)
result <- df %>% filter(!is.na(a)) %>% mutate(c = a + b)
for (i in seq_len(nrow(result))) {
  cat(sprintf("%d: %.2f\n", i, result$c[i]))
}
print(TRUE && FALSE)
