%YAML 1.2
---
# mdy for Sublime Text — a NATIVE port of the vscode extension's
# mdy.tmLanguage.json (../vscode-mdy/syntaxes/). Regexes, scope names, and
# the approximations (front-matter heuristic, %% block extent, first-}}
# closing, closer-guarded strings) are carried over from that grammar — if
# you change it, change this file to match. syntax_test_mdy.mdy pins the
# behavior (open it in Sublime, Cmd+B).
#
# This file used to `extends` Sublime's Markdown syntax and inject the
# template rules through `prototype`, which was the only way to make tag
# delimiters highlight inside the contexts markdown claims for headings,
# lists and emphasis. None of that is here any more, and the reason is not
# that a better trick was found: MDY is not Markdown. Every one of its block
# rules is anchored to the start of its own line, so this is a flat list of
# line matches with no foreign grammar underneath it and nothing to inject
# into. The two abandoned conversion routes documented here before — a
# mechanical tmLanguage conversion, and `with_prototype` around an embedded
# markdown push — were both attempts to solve a problem that stopped
# existing.
name: mdy
scope: text.html.markdown.mdy
version: 2
file_extensions:
  - mdy

variables:
  ref_name: '[\p{L}_](?:[\p{L}\p{N}_-]*[\p{L}\p{N}_])?'

contexts:
  main:
    # YAML front matter at the very start of the file: +++, YAML, +++
    # (docs/language.md §11, parseDocument). The opening fence is CONSUMED
    # by this match, not looked ahead to — a zero-width push left the
    # scanner at the same offset with mdy-frontmatter's own pop rule still
    # to try there, and `^\+\+\+[ \t]*$` matched the very fence that had
    # just opened the block, so it popped on the line it pushed. Two
    # approximations remain, both from reading one line at a time: an
    # opener with no closer paints as front matter where the parser leaves
    # it as prose (bounded by the `---` bail-out in mdy-frontmatter, so it
    # costs one document rather than the file), and blank lines before the
    # opener, which parseDocument skips, are out of \A's reach.
    - match: '\A\+\+\+[ \t]*$'
      scope: punctuation.definition.frontmatter.mdy markup.heading.frontmatter.mdy
      push: mdy-frontmatter
    - include: mdy-body

  mdy-body:
    # A bare --- splits documents (splitDocuments), wherever it appears.
    - match: '^---[ \t]*$'
      scope: punctuation.definition.separator.mdy markup.heading.separator.mdy
      push: mdy-after-separator
    # Code first: the script stage runs over the whole document before any
    # of the grammar does, so a % line is JavaScript wherever it is written,
    # inside a fenced block included.
    - match: '^[ \t]*(%%)'
      captures:
        1: punctuation.definition.script.mdy keyword.control.script.mdy
      push: mdy-script-block
    - match: '^[ \t]*(%)(?!%)'
      captures:
        1: punctuation.definition.script.mdy keyword.control.script.mdy
      push: mdy-script-line
    - match: '^[ \t]*(`{3,}|~{3,})[ \t]*([^\s`]*)'
      captures:
        1: punctuation.definition.fence.begin.mdy
        2: entity.name.type.fence.language.mdy
      push: mdy-fence
    # A # with whitespace after it, or alone on its line, is a comment.
    # #tag has none and is a reference instead.
    - match: '^[ \t]*#([ \t].*)?$'
      scope: comment.line.number-sign.mdy
    - match: '^[ \t]*(=+)[ \t]*(.*?)([ \t]*=*[ \t]*)$'
      captures:
        1: punctuation.definition.heading.mdy markup.heading.mdy
        2: entity.name.section.mdy markup.heading.mdy
        3: punctuation.definition.heading.mdy markup.heading.mdy
    - match: '^[ \t]*(?:=+|-{4,})[ \t]*$'
      scope: markup.heading.underline.mdy
    - match: '^[ \t]*([-*_])(?:[ \t]*\1){2,}[ \t]*$'
      scope: punctuation.definition.thematic-break.mdy markup.heading.break.mdy
    - match: '^[ \t]*(<!doctype[^\n>]*>?)[ \t]*$'
      captures:
        1: entity.name.tag.doctype.mdy
    - match: '^[ \t]*(<)[ \t]*([A-Za-z][A-Za-z0-9-]*)?'
      captures:
        1: punctuation.definition.tag.begin.mdy
        2: entity.name.tag.mdy
      push: mdy-element
    - match: '^[ \t]*\|?[ \t]*:?-+:?[ \t]*(\|[ \t]*:?-+:?[ \t]*)*\|?[ \t]*$'
      scope: punctuation.separator.table.delimiter.mdy markup.heading.table.mdy
    - match: '\|'
      scope: punctuation.separator.table.mdy
    - match: '^[ \t]*(?:([-*+])|(\d{1,9}[.)]))(?=[ \t])'
      captures:
        1: punctuation.definition.list.begin.mdy markup.list.unnumbered.mdy
        2: punctuation.definition.list.begin.mdy markup.list.numbered.mdy
      push: mdy-list-item
    - include: mdy-inline

  mdy-frontmatter:
    - meta_scope: meta.frontmatter.mdy
    - match: '^\+\+\+[ \t]*$'
      scope: punctuation.definition.frontmatter.mdy markup.heading.frontmatter.mdy
      pop: true
    # Front matter cannot cross a document separator, so an opener that was
    # never closed spoils its own document and no more.
    - match: '(?=^---[ \t]*$)'
      pop: true
    - include: scope:source.yaml

  # After a separator, the first non-empty line decides: a +++ fence opens
  # the new document's front matter, anything else is body. Blank lines are
  # neither, which is what lets the fence sit a line or two below the
  # separator, the way parseDocument allows.
  mdy-after-separator:
    - match: '^\+\+\+[ \t]*$'
      scope: punctuation.definition.frontmatter.mdy markup.heading.frontmatter.mdy
      set: mdy-frontmatter
    - match: '(?=[^\n])'
      pop: true

  # One % line is one line of code. What it leaves open encloses the markup
  # under it — which is how a loop is written — so its brackets are
  # deliberately not counted and the region is exactly this line.
  mdy-script-line:
    - meta_scope: meta.embedded.line.mdy
    - match: '$'
      pop: true
    - include: mdy-js

  # %% says that what follows it is more code, and runs on as far as the
  # line that brings its brackets back to even. Brackets are what a
  # line-based engine cannot count, so this approximates the extent the way
  # these blocks are actually written: it ends after the first line whose
  # own first character is a closing bracket, and before any line that
  # starts a new % of its own.
  mdy-script-block:
    - meta_scope: meta.embedded.block.mdy
    - match: '^[ \t]*[)\]}][^\n]*$'
      pop: true
    - match: '^(?=[ \t]*%)'
      pop: true
    - include: mdy-js

  mdy-fence:
    - meta_scope: markup.fenced_code.block.mdy
    - match: '^[ \t]*(`{3,}|~{3,})[ \t]*$'
      scope: punctuation.definition.fence.end.mdy
      pop: true
    - match: '^[ \t]*(%%?)'
      captures:
        1: punctuation.definition.script.mdy keyword.control.script.mdy
      push: mdy-script-line
    - match: '[^\n]'
      scope: markup.raw.block.mdy

  # A line starting with < opens an element, and everything indented two
  # columns past it is its content — there is no closing tag to match, so
  # this ends at the end of the line and the nesting is the indentation's
  # business, not the grammar's.
  mdy-element:
    - match: '$'
      pop: true
    - match: '(>|/>)'
      scope: punctuation.definition.tag.end.mdy
      set: mdy-element-content
    - match: '([A-Za-z_:][A-Za-z0-9._:-]*)[ \t]*(=)'
      captures:
        1: entity.other.attribute-name.mdy
        2: punctuation.separator.key-value.mdy
      push: mdy-attribute-value
    - match: '[A-Za-z_:][A-Za-z0-9._:-]*'
      scope: entity.other.attribute-name.mdy

  mdy-attribute-value:
    - meta_scope: string.quoted.mdy
    - match: '"[^"\n]*"?|''[^''\n]*''?|[^\s>]+'
      scope: string.quoted.mdy
      pop: true
    - match: '(?=[\s>])'
      pop: true

  mdy-element-content:
    - match: '$'
      pop: true
    - include: mdy-inline

  mdy-list-item:
    - match: '$'
      pop: true
    - match: '\G[ \t]+(\[)([ xX])(\])(?=[ \t])'
      captures:
        1: punctuation.definition.task.mdy
        2: constant.language.task.mdy
        3: punctuation.definition.task.mdy
    - include: mdy-inline

  mdy-inline:
    # A backslash before the % a line opens with, or before {{, opts out.
    - match: '^[ \t]*\\%|\\\{\{'
      scope: constant.character.escape.mdy
    - match: '\{\{'
      scope: punctuation.section.embedded.begin.expression.mdy keyword.other.template.mdy
      push: mdy-interpolation
    - match: '``(?:[^`\n]|`(?!`))*``'
      scope: markup.inline.raw.mdy
    - match: '(\[\[)([^\]|\n]*)(?:(\|)([^\]\n]*))?(\]\])'
      captures:
        1: punctuation.definition.link.begin.mdy
        2: string.other.link.title.mdy
        3: punctuation.separator.link.mdy
        4: markup.underline.link.mdy
        5: punctuation.definition.link.end.mdy
    # URLs are found before the markers, so the // in https:// never opens
    # a run of emphasis.
    - match: '(?:[a-z][a-z0-9+.-]*://|mailto:)[^\s<>"''`]+|//[\w-]+(?:\.[\w-]+)+(?:/[^\s<>"''`]*)?|[\w.!#$%&''*+/=?^`{|}~-]+@[\w-]+(?:\.[\w-]+)+'
      scope: markup.underline.link.mdy
    # #tag and @user, each only at the start of a word, and never starting
    # with a digit — so #42 stays the issue number it was written as.
    - match: '(?<![\p{L}\p{N}_])([#@])({{ref_name}})'
      scope: variable.other.reference.mdy
      captures:
        1: punctuation.definition.reference.mdy
    - match: ':[a-z0-9_+-]+:'
      scope: constant.character.emoji.mdy
    - match: '!!|\*\*'
      scope: markup.bold.mdy punctuation.definition.bold.mdy
    - match: '//'
      scope: markup.italic.mdy punctuation.definition.italic.mdy
    - match: '__'
      scope: markup.underline.mdy punctuation.definition.underline.mdy
    - match: '~~'
      scope: markup.strikethrough.mdy punctuation.definition.strikethrough.mdy
    - match: '\?\?|\^\^|,,'
      scope: markup.other.mdy punctuation.definition.marker.mdy

  # {{ expr }} — closes at the FIRST }}, matching the compiler's indexOf.
  mdy-interpolation:
    - meta_scope: meta.template.expression.mdy
    - meta_content_scope: meta.embedded.line.mdy
    - match: '\}\}'
      scope: punctuation.section.embedded.end.expression.mdy keyword.other.template.mdy
      pop: true
    - include: mdy-js-in-interpolation

  # JS inside {{ }} — strings/comments guarded against }} (the compiler
  # closes there even mid-string; a construct spanning the closer would eat
  # the delimiter).
  mdy-js-in-interpolation:
    - match: '//(?:(?!\}\})[^\n])*'
      scope: comment.line.double-slash.js.mdy
    - match: '/\*'
      push:
        - meta_scope: comment.block.js.mdy
        - match: '\*/|(?=\}\})'
          pop: true
    - match: '(["''])(?:\\.|(?!\}\}|\1)[^\n\\])*\1'
      scope: string.quoted.js.mdy
    - match: '`'
      push:
        - meta_scope: string.template.js.mdy
        - match: '`|(?=\}\})'
          pop: true
        - match: '\\.'
    - include: mdy-js-common

  # JS on a % or %% line. Nothing is guarded: a code line runs to the end of
  # the line and a %% block to the line that closes it, so there is no
  # delimiter further along for a string or a comment to eat.
  mdy-js:
    - match: '//[^\n]*'
      scope: comment.line.double-slash.js.mdy
    - match: '/\*'
      push:
        - meta_scope: comment.block.js.mdy
        - match: '\*/'
          pop: true
    - match: '(["''])(?:\\.|[^\n\\])*?\1'
      scope: string.quoted.js.mdy
    - match: '`'
      push:
        - meta_scope: string.template.js.mdy
        - match: '`'
          pop: true
        - match: '\\.'
    - include: mdy-js-common

  # Region-free JS token rules shared by every code context. $ before . is
  # the document's native-function namespace ($.find, $.render, $.emit, …);
  # req, res and transform are the names a document is always handed.
  mdy-js-common:
    - match: '\$(?=\s*\.)'
      scope: variable.language.dollar.mdy
    - match: '\b(?:req|res)\b(?=\s*[.\[])'
      scope: variable.language.mdy
    - match: '\b(?:transform|visit|h|toText|slug)\b(?=\s*\()'
      scope: support.function.mdy
    - match: '\b(?:const|let|var|function|return|if|else|for|while|do|break|continue|new|typeof|instanceof|of|in|try|catch|finally|throw|switch|case|default|async|await|yield|class|extends|import|export|from|delete|void)\b'
      scope: keyword.control.js.mdy
    - match: '\b(?:true|false|null|undefined|NaN|Infinity)\b'
      scope: constant.language.js.mdy
    - match: '\bthis\b'
      scope: variable.language.this.js.mdy
    - match: '\b\d[\d_]*(?:\.\d+)?(?:[eE][+-]?\d+)?\b'
      scope: constant.numeric.js.mdy
    - match: '=>'
      scope: storage.type.function.arrow.js.mdy
    - match: '[+\-*/<>=!&|?:]'
      scope: keyword.operator.js.mdy
