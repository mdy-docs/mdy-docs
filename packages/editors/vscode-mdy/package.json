{
  "name": "vscode-mdy",
  "displayName": "mdy",
  "description": "Support for .mdy documents: syntax highlighting, folding, outline, and a live rendered preview. The MDY markup language, with YAML front matter and JavaScript on % and %% lines.",
  "version": "0.0.11",
  "type": "module",
  "main": "./extension.cjs",
  "activationEvents": [],
  "publisher": "mdy-docs",
  "license": "BSD-2-Clause",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "scripts": {
    "bundle-engine": "node scripts/bundle-engine.mjs",
    "pretest": "npm run bundle-engine",
    "test": "node --test test/*.test.js",
    "vscode:prepublish": "npm run bundle-engine",
    "package": "vsce package",
    "publish:open-vsx": "ovsx publish"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2",
    "@vscode/vsce": "^3.6.2",
    "ovsx": "^0.10.6"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mdy-docs/mdy-docs.git",
    "directory": "packages/editors/vscode-mdy"
  },
  "contributes": {
    "commands": [
      {
        "command": "mdy.showPreview",
        "title": "Open Preview",
        "category": "mdy",
        "icon": "$(preview)"
      },
      {
        "command": "mdy.showPreviewToSide",
        "title": "Open Preview to the Side",
        "category": "mdy",
        "icon": "$(open-preview)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "mdy.showPreview",
          "when": "editorLangId == mdy",
          "group": "navigation@1"
        },
        {
          "command": "mdy.showPreviewToSide",
          "when": "editorLangId == mdy",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "mdy.showPreview",
          "when": "editorLangId == mdy"
        },
        {
          "command": "mdy.showPreviewToSide",
          "when": "editorLangId == mdy"
        }
      ]
    },
    "keybindings": [
      {
        "command": "mdy.showPreview",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "editorLangId == mdy && editorTextFocus"
      },
      {
        "command": "mdy.showPreviewToSide",
        "key": "ctrl+k v",
        "mac": "cmd+k v",
        "when": "editorLangId == mdy && editorTextFocus"
      }
    ],
    "languages": [
      {
        "id": "mdy",
        "aliases": [
          "mdy",
          "Mdy"
        ],
        "extensions": [
          ".mdy"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "mdy",
        "scopeName": "text.html.markdown.mdy",
        "path": "./syntaxes/mdy.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.line.mdy": "javascript",
          "source.yaml": "yaml"
        }
      }
    ]
  },
  "icon": "icon.png",
  "keywords": [
    "mdy",
    "markup",
    "yaml",
    "front matter",
    "templates",
    "static site generator",
    "documents"
  ]
}