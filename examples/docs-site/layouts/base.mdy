<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ arg.page.title ? arg.page.title + " | " + arg.site.title : arg.site.title }}</title>
<meta name="description" content="{{ arg.site.description }}">
<link rel="icon" href="/favicon.svg">
<link rel="stylesheet" href="/style.css">
<script>try { const s = localStorage.getItem("mdy-docs-theme"); if (s === "dark" || (!s && matchMedia("(prefers-color-scheme: dark)").matches)) document.documentElement.classList.add("dark"); } catch (e) {}</script>
</head>
<body class="{{ arg.page.layout === "home" ? "layout-home" : "layout-doc" }}">
<header class="navbar">
<div class="navbar-inner">
<button class="hamburger" id="hamburger" aria-label="Toggle sidebar"><span></span><span></span><span></span></button>
<a class="brand" href="/"><img src="/favicon.svg" alt="" class="brand-logo">{{ arg.site.title }}</a>
<div class="navbar-right">
<div class="search-box" id="search-box">
<input id="search-input" type="search" placeholder="Search" autocomplete="off" aria-label="Search docs">
<ul id="search-results" hidden></ul>
</div>
<nav class="nav-links" aria-label="Main navigation">
{% for (const n of arg.nav) { %}
<a href="{{ n.link }}" class="nav-link{{ arg.page.section && n.link === "/" + arg.page.section + "/" ? " active" : "" }}"{{ n.link.indexOf("http") === 0 ? ' target="_blank" rel="noreferrer"' : "" }}>{{ n.text }}</a>
{% } %}
</nav>
<button id="theme-toggle" class="theme-toggle" aria-label="Toggle dark mode"><svg class="sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg><svg class="moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg></button>
<div class="social-links">
{% for (const s of arg.socialLinks) { %}
{% if (s.icon === "github") { %}
<a class="social-link" href="{{ s.link }}" target="_blank" rel="noreferrer" aria-label="GitHub"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg></a>
{% } %}
{% if (s.icon === "npm") { %}
<a class="social-link" href="{{ s.link }}" target="_blank" rel="noreferrer" aria-label="npm"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M0 0v24h24V0H0zm19.2 19.2h-2.4V9.6h-4.8v9.6H4.8V4.8h14.4v14.4z"/></svg></a>
{% } %}
{% } %}
</div>
</div>
</div>
</header>
{% if (arg.page.layout === "home") { %}
<main class="home-main">
{{ arg.content }}
</main>
<footer class="footer">
<p class="footer-message">{{ arg.footer.message }}</p>
<p class="footer-copyright">{{ arg.footer.copyright }}</p>
</footer>
{% } else { %}
<div class="page-wrap">
<div class="sidebar-mask" id="sidebar-mask"></div>
<aside class="sidebar" id="sidebar">
<nav class="sidebar-top-nav">
{% for (const n of arg.nav) { %}
<a href="{{ n.link }}"{{ n.link.indexOf("http") === 0 ? ' target="_blank" rel="noreferrer"' : "" }}>{{ n.text }}</a>
{% } %}
</nav>
{{ arg.sidebarHtml }}
</aside>
<main class="content">
<div class="doc">
<article class="doc-body">
{{ arg.content }}
</article>
<div class="doc-footer">
<div class="edit-info">
{% if (arg.editUrl) { %}
<a class="edit-link" href="{{ arg.editUrl }}" target="_blank" rel="noreferrer"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg> {{ arg.editText }}</a>
{% } %}
{% if (arg.lastUpdated) { %}
<span class="last-updated">Last updated: <time>{{ arg.lastUpdated }}</time></span>
{% } %}
</div>
{{ arg.prevNextHtml }}
</div>
</div>
<div class="aside">
{{ arg.outlineHtml }}
</div>
</main>
</div>
{% } %}
<script src="/docs.js"></script>
</body>
</html>
