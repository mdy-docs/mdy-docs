< div class="home"
  < section class="hero"
    < div class="hero-text"
      <h1 class="hero-name">{{ req.hero.name }}
      <p class="hero-heading">{{ req.hero.text }}
      <p class="hero-tagline">{{ req.hero.tagline }}
      < div class="hero-actions"
        % for (const a of req.hero.actions ?? []) {
        %   const away = a.link.indexOf("http") === 0 ? ' target="_blank" rel="noreferrer"' : ""
        <a class="hero-action {{ a.theme }}" href="{{ a.link }}"{{ away }}>{{ a.text }}
        % }
    < div class="hero-image"
      <img src="/favicon.svg" alt=""
  < section class="features"
    % for (const f of req.features) {
    < div class="feature"
      <h2 class="feature-title">{{ f.title }}
      <p class="feature-details">{{ f.details }}
    % }
