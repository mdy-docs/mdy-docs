site:
  title: lamassu-js
  description: A strict, safe JavaScript-subset engine written in C, compiled to WebAssembly — sandboxed evaluation for untrusted templates.
nav:
  - text: Guide
    link: /guide/
  - text: API Reference
    link: /api/
  - text: Playground
    link: https://mdy-docs.github.io/lamassu-js/
sidebar:
  guide:
    - text: Introduction
      items:
        - text: What is lamassu-js?
          link: /guide/
    - text: The language
      items:
        - text: Supported syntax
          link: /guide/language/
        - text: Built-ins
          link: /guide/builtins/
        - text: Async & host calls
          link: /guide/async/
        - text: Deviations from real JS
          link: /guide/deviations/
  api:
    - text: API Reference
      items:
        - text: Overview
          link: /api/
        - text: npm package
          link: /api/npm-package/
        - text: C embedding API
          link: /api/c-embedding/
socialLinks:
  - icon: github
    link: https://github.com/mdy-docs/lamassu-js
  - icon: npm
    link: https://www.npmjs.com/package/@mdy-docs/lamassu-js
editLink:
  pattern: "https://github.com/mdy-docs/lamassu-js/edit/main/docs-site/:path"
  text: Edit this page on GitHub
footer:
  message: Released under the MIT License.
  copyright: Copyright © lamassu-js contributors
+++
{%
  // The whole site is defined right here: which files are pages, what URL
  // each gets, the sidebar/outline/pager around it — the same content
  // files VitePress rendered, but the config + theme are replaced by this
  // script, two .mdy layouts, and static/{style.css,docs.js}.
  const md = await import("./lib/md.js");
  const html = await import("./lib/html.js");

  // Every .md file under the site root is a page; its URL comes from its
  // path (guide/language.md → /guide/language/, guide/index.md → /guide/).
  // The home page is index.mdy (rendered below) — a real mdy document, so
  // its hero/features front matter needs no host-side parsing at all.
  const pages = [];
  for (const raw of $.find({})) {
    if (raw.ext !== ".md" || raw.path === "README.md") { continue; }
    const stem = raw.path.slice(0, -3);
    let url;
    if (stem.slice(-6) === "/index") {
      url = "/" + stem.slice(0, -5);
    } else {
      url = "/" + stem + "/";
    }
    pages.push({ raw: raw, url: url, section: url.split("/")[1] || "" });
  }

  // Flatten each section's sidebar for prev/next links, VitePress-style.
  const flat = {};
  for (const key of Object.keys(sidebar)) {
    const items = [];
    for (const g of sidebar[key]) {
      for (const it of g.items) { items.push(it); }
    }
    flat[key] = items;
  }

  const searchRecords = [];

  for (const p of pages) {
    const body = md.rewriteLinks(md.transformContainers(md.stripFrontMatter(p.raw.body)));
    const headings = $.toc(body);
    const h1 = headings.find((e) => e.depth === 1);
    const title = h1 ? h1.text : p.raw.name;
    const items = flat[p.section] || [];
    let at = -1;
    for (let i = 0; i < items.length; i += 1) {
      if (items[i].link === p.url) { at = i; }
    }
    const pageHtml = $.render({ path: "layouts/base.mdy" }, {
      site: site, nav: nav, footer: footer, socialLinks: socialLinks,
      page: { title: title, url: p.url, layout: "doc", section: p.section },
      content: $.markdown(body),
      sidebarHtml: html.sidebarHtml(sidebar[p.section] || [], p.url),
      outlineHtml: html.outlineHtml(headings.filter((e) => e.depth === 2 || e.depth === 3)),
      prevNextHtml: html.prevNextHtml(at > 0 ? items[at - 1] : null, at >= 0 && at < items.length - 1 ? items[at + 1] : null),
      editUrl: editLink.pattern.replace(":path", p.raw.path),
      editText: editLink.text,
      lastUpdated: md.formatDate(p.raw.mtime),
    });
    $.emit(p.url.slice(1) + "index.html", pageHtml);
    searchRecords.push({ url: p.url, title: title, excerpt: md.excerpt(md.stripFrontMatter(p.raw.body)), words: $.tokenize(title + " " + p.raw.body) });
  }

  // Home page: index.mdy — a data-only mdy document whose front matter IS
  // the hero + features config, already parsed by mdy's own parser.
  const home = $.findOne({ path: "index.mdy" });
  const heroHtml = $.render({ path: "layouts/home.mdy" }, { hero: home.hero || {}, features: home.features || [] });
  $.emit("index.html", $.render({ path: "layouts/base.mdy" }, {
    site: site, nav: nav, footer: footer, socialLinks: socialLinks,
    page: { title: "", url: "/", layout: "home", section: "" },
    content: heroHtml,
    sidebarHtml: "", outlineHtml: "", prevNextHtml: "", editUrl: "", editText: "", lastUpdated: "",
  }));
  searchRecords.push({ url: "/", title: (home.hero && home.hero.name) || site.title, excerpt: (home.hero && home.hero.tagline) || site.description, words: $.tokenize(site.title + " " + site.description) });

  // 404 page (VitePress emits one too).
  const nfHtml = '<div class="not-found"><p class="nf-code">404</p><h1 class="nf-title">PAGE NOT FOUND</h1><div class="nf-divider"></div><blockquote class="nf-quote">But if you don\'t change your direction, and if you keep looking, you may end up where you are heading.</blockquote><a class="hero-action brand" href="/">Take me home</a></div>';
  $.emit("404.html", $.render({ path: "layouts/base.mdy" }, {
    site: site, nav: nav, footer: footer, socialLinks: socialLinks,
    page: { title: "404", url: "/404.html", layout: "home", section: "" },
    content: nfHtml,
    sidebarHtml: "", outlineHtml: "", prevNextHtml: "", editUrl: "", editText: "", lastUpdated: "",
  }));

  $.emit("search-index.json", JSON.stringify(searchRecords));
%}

lamassu-js docs — {{ pages.length }} page(s) emitted from this one script.
