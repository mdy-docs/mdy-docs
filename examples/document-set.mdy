title: Team Roster
+++
# {{ self.title }}

{% const card = $.findOne({ template: 'member-card' }) %}
{% for (const m of $.find({ role: 'member' })) { %}
{{ $.render(card, m) }}
{% } %}
---
template: member-card
+++
### {{ arg.name }}

- Age: {{ arg.age ?? 'unknown' }}
- Skills: {{ (arg.skills ?? []).join(', ') }}
---
role: member
name: Alice
age: 30
skills: [js, python]
+++
---
role: member
name: Bob
skills: [go, rust]
+++
