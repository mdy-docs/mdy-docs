+++
title: Team Roster
+++
= {{ res.data.title }}

% const card = $.findOne({ template: 'member-card' })
% for (const m of $.find({ role: 'member' })) {
{{ $.render(card, m) }}
% }
---
+++
template: member-card
+++
=== {{ req.name }}

- Age: {{ req.age ?? 'unknown' }}
- Skills: {{ (req.skills ?? []).join(', ') }}
---
+++
role: member
name: Alice
age: 30
skills: [js, python]
+++
---
+++
role: member
name: Bob
skills: [go, rust]
+++
