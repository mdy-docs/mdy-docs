<!doctype html>
< html lang="en"
  < head
    <meta charset="utf-8"
    <meta name="viewport" content="width=device-width, initial-scale=1"
    <title>{{ req.page.title && req.page.title !== req.site.title ? req.page.title + " — " + req.site.title : req.site.title }}
    <link rel="stylesheet" href="/style.css"
    <link rel="alternate" type="application/rss+xml" title="{{ req.site.title }}" href="/feed.xml"
  < body
    < header
      <a href="/">{{ req.site.title }}
      <nav>[[ About | /about/ ]] · [[ Tags | /tags/ ]]
      < search
        <input id="search-input" type="search" placeholder="Search…" aria-label="Search"
        <ul id="search-results"
    < main
      {{ req.content }}
    < footer
      © {{ req.site.author }}
      <p>[[ 404 | /404.html ]]
    <script src="/search.js"
