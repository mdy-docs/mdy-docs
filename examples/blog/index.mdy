title: Tablet House
baseURL: https://example.com
author: Daniel Walton
description: Notes from the scribal school.
+++
{%
  const site = { title: title, baseURL: baseURL, author: author, description: description };
  const draftsOn = typeof drafts !== "undefined" ? drafts : false;
  const futureOn = typeof future !== "undefined" ? future : false;

  const humanize = (s) => s.replace(/-+/g, " ").trim().replace(/^./, (c) => c.toUpperCase());
  const summarize = (text) => text.replace(/^#.*$/m, "").replace(/[#*_>]/g, "").replace(/\s+/g, " ").trim().slice(0, 200);

  // Every posts/*.mdy or posts/*.md file is a raw document — no
  // host-computed date/slug/url; this script derives all of that itself,
  // from the filename, right here. A .md file has no front matter (it's
  // never compiled as a template — walkRawSources gives it real text as
  // meta.body, never as `text`), so its date/title always fall back to
  // the filename; its #hashtags are still extracted into meta.tags.
  const rawPosts = $.find({}).filter((d) => d.path && d.path.indexOf("posts/") === 0 && (d.ext === ".mdy" || d.ext === ".md"));
  const posts = [];
  for (const raw of rawPosts) {
    const stem = raw.path.slice("posts/".length, -raw.ext.length);
    const m = /^(\d{4}-\d{2}(?:-\d{2})?)-/.exec(stem);
    const fromFilename = m ? (m[1].length === 7 ? m[1] + "-01" : m[1]) : "1970-01-01";
    const date = raw.date ? String(raw.date).slice(0, 10) : fromFilename;
    const slug = m ? stem.slice(m[1].length + 1) : stem;
    const postTitle = raw.title || humanize(slug);
    const isDraft = raw.draft === true;
    const isFuture = date > today;
    if ((!isDraft || draftsOn) && (!isFuture || futureOn)) {
      const bodyMd = raw.ext === ".md" ? raw.body : $.render({ path: raw.path }, {});
      posts.push({ path: raw.path, date: date, slug: slug, url: "/posts/" + slug + "/", title: postTitle, tags: raw.tags || [], summary: summarize(bodyMd), body: bodyMd });
    }
  }
  posts.sort((a, b) => (a.date < b.date ? 1 : -1));

  const sitemapUrls = [];

  // each post: its own page, wrapped in layouts/post.mdy then layouts/base.mdy
  for (const p of posts) {
    const related = posts.filter((o) => o.slug !== p.slug && o.tags.some((t) => p.tags.indexOf(t) !== -1)).map((o) => ({ title: o.title, url: o.url }));
    const postMd = $.render({ path: "layouts/post.mdy" }, { title: p.title, date: p.date, content: p.body, related: related });
    const postHtml = $.markdown(postMd);
    const postPage = $.render({ path: "layouts/base.mdy" }, { content: postHtml, page: { title: p.title, url: p.url }, site: site });
    $.emit("posts/" + p.slug + "/index.html", postPage);
    sitemapUrls.push(p.url);
  }

  // homepage: layouts/list.mdy, newest post first, single page (no pagination)
  const pagination = { page: 1, totalPages: 1, prevUrl: null, nextUrl: null };
  const listMd = $.render({ path: "layouts/list.mdy" }, { posts: posts, pagination: pagination, site: site });
  const listHtml = $.markdown(listMd);
  const homePage = $.render({ path: "layouts/base.mdy" }, { content: listHtml, page: { title: site.title, url: "/" }, site: site });
  $.emit("index.html", homePage);
  sitemapUrls.push("/");

  // about: layouts/page.mdy (root-level page, no section) then layouts/base.mdy
  const aboutRaw = $.findOne({ path: "about.mdy" });
  const aboutBody = $.render({ path: "about.mdy" }, {});
  const aboutTitle = aboutRaw.title || "About";
  const aboutMd = $.render({ path: "layouts/page.mdy" }, { title: aboutTitle, content: aboutBody });
  const aboutHtml = $.markdown(aboutMd);
  const aboutPage = $.render({ path: "layouts/base.mdy" }, { content: aboutHtml, page: { title: aboutTitle, url: "/about/" }, site: site });
  $.emit("about/index.html", aboutPage);
  sitemapUrls.push("/about/");

  // tags: every taggable page (posts + about), grouped; /tags/<tag>/ + /tags/
  const taggable = posts.concat([{ title: aboutTitle, url: "/about/", date: today, tags: aboutRaw.tags || [] }]);
  const tagged = {};
  for (const p of taggable) {
    for (const t of p.tags) {
      if (!tagged[t]) { tagged[t] = []; }
      tagged[t].push(p);
    }
  }
  const tagNames = Object.keys(tagged).sort();
  for (const t of tagNames) {
    const list = tagged[t];
    list.sort((a, b) => (a.date < b.date ? 1 : -1));
    const tagMd = $.render({ path: "layouts/tag.mdy" }, { tag: t, posts: list, url: "/tags/" + t + "/" });
    const tagHtml = $.markdown(tagMd);
    const tagPage = $.render({ path: "layouts/base.mdy" }, { content: tagHtml, page: { title: "#" + t, url: "/tags/" + t + "/" }, site: site });
    $.emit("tags/" + t + "/index.html", tagPage);
    sitemapUrls.push("/tags/" + t + "/");
  }
  const tagsList = tagNames.map((t) => ({ tag: t, url: "/tags/" + t + "/", count: tagged[t].length }));
  const tagsMd = $.render({ path: "layouts/tags.mdy" }, { tags: tagsList });
  const tagsHtml = $.markdown(tagsMd);
  const tagsPage = $.render({ path: "layouts/base.mdy" }, { content: tagsHtml, page: { title: "Tags", url: "/tags/" }, site: site });
  $.emit("tags/index.html", tagsPage);
  sitemapUrls.push("/tags/");

  // 404, RSS, sitemap, robots: no markdown pass for the latter three, raw text
  const nfMd = $.render({ path: "layouts/404.mdy" }, {});
  const nfHtml = $.markdown(nfMd);
  const nfPage = $.render({ path: "layouts/base.mdy" }, { content: nfHtml, page: { title: "Not found", url: "/404.html" }, site: site });
  $.emit("404.html", nfPage);

  const feedXml = $.render({ path: "layouts/rss.mdy" }, { posts: posts, site: site });
  $.emit("feed.xml", feedXml);

  sitemapUrls.sort();
  const sitemapXml = $.render({ path: "layouts/sitemap.mdy" }, { urls: sitemapUrls, site: site });
  $.emit("sitemap.xml", sitemapXml);

  const robotsTxt = $.render({ path: "layouts/robots.mdy" }, { site: site });
  $.emit("robots.txt", robotsTxt);

  // search-index.json: nisaba's real tokenizer via $.tokenize, no host batch step
  const searchRecords = [];
  for (const p of posts) {
    const words = $.tokenize([p.title].concat(p.tags).concat([p.body]).join(" "));
    if (words.length > 0) {
      searchRecords.push({ url: p.url, title: p.title, excerpt: p.summary, tags: p.tags, words: words });
    }
  }
  const aboutWords = $.tokenize([aboutTitle].concat(aboutRaw.tags || []).concat([aboutBody]).join(" "));
  if (aboutWords.length > 0) {
    searchRecords.push({ url: "/about/", title: aboutTitle, excerpt: summarize(aboutBody), tags: aboutRaw.tags || [], words: aboutWords });
  }
  $.emit("search-index.json", JSON.stringify(searchRecords));
%}

Tablet House — built entirely from this one script: {{ posts.length }} post(s), {{ tagNames.length }} tag(s).
