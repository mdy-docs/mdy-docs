{
  "name": "vscode-mdy",
  "displayName": "mdy",
  "description": "Syntax highlighting for .mdy documents: markdown with YAML front matter and embedded {{ }} / {% %} JavaScript template tags.",
  "version": "0.0.3",
  "private": true,
  "type": "module",
  "publisher": "mdy-docs",
  "license": "BSD-2-Clause",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mdy-docs/mdy-docs.git",
    "directory": "editors/vscode-mdy"
  },
  "contributes": {
    "languages": [
      {
        "id": "mdy",
        "aliases": [
          "mdy",
          "Mdy"
        ],
        "extensions": [
          ".mdy"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "mdy",
        "scopeName": "text.html.markdown.mdy",
        "path": "./syntaxes/mdy.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.line.mdy": "javascript",
          "source.yaml": "yaml",
          "text.html.markdown": "markdown"
        }
      }
    ]
  }
}
